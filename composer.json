{
    "name": "springtimesoft/silverstripe-cloudflare-assets-purge",
    "description": "Queues a Cloudflare cache purge when Silverstripe assets are published, unpublished, or deleted",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/springtimesoft/silverstripe-cloudflare-assets-purge",
    "keywords": [
        "silverstripe",
        "cloudflare",
        "cache",
        "cdn"
    ],
    "support": {
        "issues": "https://github.com/springtimesoft/silverstripe-cloudflare-assets-purge/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Springtimesoft",
            "homepage": "https://springtimesoft.co.nz/"
        }
    ],
    "require": {
        "ext-curl": "*",
        "silverstripe/framework": "^6",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "autoload": {
        "psr-4": {
            "Springtimesoft\\CloudflareAssetsPurge\\": "src/"
        }
    }
}
